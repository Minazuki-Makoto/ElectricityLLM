# ElectricityLLM deployment environment template.
# Copy to .env on the server and replace every CHANGE_ME value.
# Never commit the real .env file.

# GLM API
GLM_API_KEY=CHANGE_ME
GLM_MODEL_NAME=glm-5.2
GLM_IMPORTANT_SMALL_MODEL_NAME=glm-4.5-air
GLM_SMALL_MODEL_NAME=glm-4.7-flashx

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=scms
MYSQL_USERNAME=electricity_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=384mb
REDIS_MAXMEMORY_POLICY=noeviction

# Elasticsearch
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_TEXT_INDEX=electricity-infos
ELASTICSEARCH_PLOT_INDEX=electricity-plot-data
ELASTICSEARCH_GRAPH_INDEX=graph_index
ELASTICSEARCH_MEMORY_INDEX=memory-history
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=768m
NEO4J_PAGECACHE=512m

# MinIO
# Python endpoint has no scheme; Java URL includes the scheme.
MINIO_ENDPOINT=minio:9000
MINIO_URL=http://minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_PLOT_BUCKET=plot
MINIO_DOCUMENT_BUCKET=contracts

# CPU models mounted read-only into the Python container
EMBEDDING_MODEL_PATH=/models/bge-m3
EMBEDDING_MODEL_DEVICE=cpu
RERANKER_MODEL_PATH=/models/reranker-model
RERANKER_MODEL_DEVICE=cpu

# Python / Java applications
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_URL=http://python-agent:5000
SERVER_PORT=8088
JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m
AGENT_OUTPUT_PATH=/app/logs/output-result.json
GUNICORN_TIMEOUT_SECONDS=300
LIGHTGRAPH_PIPELINE_PATH=/app/lightgraph-pipeline
LIGHTGRAPH_PYTHON_PATH=/usr/local/bin/python
LIGHTGRAPH_TEMP_PATH=/tmp/LightGraph

# RocketMQ 5.x Proxy endpoint and low-concurrency topics
ROCKETMQ_ENDPOINTS=rocketmq-proxy:8081
ROCKETMQ_TASK_TOPIC=llm-task-topic
ROCKETMQ_RESULT_TOPIC=llm-task-result-topic
ROCKETMQ_CONSUMER_GROUP=llm-task-consumer-group
ROCKETMQ_TASK_TAG=LLM_TASK
ROCKETMQ_PRODUCER_MAX_ATTEMPTS=3
ROCKETMQ_CONSUMER_MAX_RETRY_ATTEMPTS=3
ROCKETMQ_BROKER_JAVA_OPTS=-Xms256m -Xmx512m
ROCKETMQ_PROXY_JAVA_OPTS=-Xms128m -Xmx384m
ROCKETMQ_NAMESRV_JAVA_OPTS=-Xms128m -Xmx256m

# Streams and timeouts
CHAT_STREAM_TTL_SECONDS=900
SHORT_MEMORY_MAX_HISTORY=20
SHORT_MEMORY_TTL_SECONDS=86400
SSE_TIMEOUT_MILLIS=600000
FLASK_CONNECT_TIMEOUT_SECONDS=10
FLASK_READ_TIMEOUT_SECONDS=330

# Public Nginx listener. Add TLS/certificates before opening 443.
HTTP_PORT=80
